---
const clubeLinks = [
  { label: 'História', href: '/clube/historia' },
  { label: 'Conquistas', href: '/clube/conquistas' },
  { label: 'Órgãos Sociais', href: '/clube/orgaos-sociais' },
  { label: 'Regulamentos', href: '/clube/regulamentos' },
];

const modalidadesLinks = [
  { label: 'Futebol', href: '/modalidades/futebol' },
  { label: 'Ginástica', href: '/modalidades/ginastica' },
  { label: 'Karaté', href: '/modalidades/karate' },
  { label: 'Boxe Olímpico', href: '/modalidades/boxe' },
  { label: 'Halterofilismo', href: '/modalidades/halterofilismo' },
];

const navLinks = [
  { label: 'Notícias', href: '/noticias' },
  { label: 'Eventos', href: '/eventos' },
  { label: 'Contactos', href: '/contactos' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav" id="nav-header">
  <div class="nav__inner container">
    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="Grupo Sportivo de Carcavelos — Página Inicial">
      <svg class="nav__logo-mark" width="28" height="28" viewBox="0 0 28 28" fill="none">
        <rect width="28" height="28" rx="7" fill="url(#gsc-logo-gradient)"/>
        <text x="14" y="19" text-anchor="middle" font-size="13" font-weight="800" fill="#ffffff" font-family="system-ui">G</text>
        <defs>
          <linearGradient id="gsc-logo-gradient" x1="0" y1="0" x2="28" y2="28">
            <stop stop-color="#16A34A"/>
            <stop offset="1" stop-color="#15803D"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="nav__logo-text">GSC</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav__links" aria-label="Navegação principal">
      <!-- Clube Dropdown -->
      <div class="nav__dropdown">
        <a href="/clube/historia" class:list={['nav__link', { 'nav__link--active': currentPath.startsWith('/clube') }]}>
          Clube
          <svg class="nav__dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="nav__dropdown-menu">
          {clubeLinks.map((link) => (
            <a href={link.href} class="nav__dropdown-item">{link.label}</a>
          ))}
        </div>
      </div>

      <!-- Modalidades Dropdown -->
      <div class="nav__dropdown">
        <a href="/modalidades" class:list={['nav__link', { 'nav__link--active': currentPath.startsWith('/modalidades') }]}>
          Modalidades
          <svg class="nav__dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="nav__dropdown-menu">
          <a href="/modalidades" class="nav__dropdown-item nav__dropdown-item--all">Todas as Modalidades</a>
          {modalidadesLinks.map((link) => (
            <a href={link.href} class="nav__dropdown-item">{link.label}</a>
          ))}
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': currentPath === link.href }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="nav__actions">
      <a href="/login" class="btn btn--secondary btn--sm btn--pill nav__cta" id="nav-login-btn" style="margin-right: var(--space-2);">
        Login
      </a>
      <a href="/socios" class="btn btn--primary btn--sm btn--pill nav__cta" id="nav-signup-btn">
        Torna-te Sócio
      </a>
    </div>

    <!-- Mobile Toggle -->
    <button class="nav__toggle" id="mobile-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="nav__mobile" id="mobile-menu" aria-hidden="true">
    <nav class="nav__mobile-inner">
      <div class="nav__mobile-links">
        <a href="/" class="nav__mobile-link">Início</a>
        <div class="nav__mobile-section">
          <span class="nav__mobile-section-title">Clube</span>
          {clubeLinks.map((link) => (
            <a href={link.href} class="nav__mobile-link nav__mobile-link--sub">{link.label}</a>
          ))}
        </div>
        <div class="nav__mobile-section">
          <span class="nav__mobile-section-title">Modalidades</span>
          <a href="/modalidades" class="nav__mobile-link nav__mobile-link--sub">Todas</a>
          {modalidadesLinks.map((link) => (
            <a href={link.href} class="nav__mobile-link nav__mobile-link--sub">{link.label}</a>
          ))}
        </div>
        {navLinks.map((link) => (
          <a href={link.href} class="nav__mobile-link">{link.label}</a>
        ))}
      </div>
      <a href="/login" class="btn btn--secondary btn--lg nav__mobile-cta" id="mobile-login-btn" style="width:100%; margin-bottom: var(--space-2);">
        Login
      </a>
      <a href="/socios" class="btn btn--primary btn--lg nav__mobile-cta" id="mobile-signup-btn" style="width:100%;">
        Torna-te Sócio
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-sticky);
    transition: all var(--transition-base);
  }

  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    border-bottom: 1px solid transparent;
    transition: all var(--transition-slow);
  }

  .nav.scrolled::before {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px) saturate(1.8);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    border-bottom-color: var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  /* Logo */
  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    z-index: calc(var(--z-sticky) + 1);
  }

  .nav__logo-text {
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  /* Desktop Links */
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link {
    position: relative;
    padding: 0.4rem 0.75rem;
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    color: #000000;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav__link:hover {
    color: var(--color-accent);
  }

  .nav__link--active {
    color: var(--color-accent);
  }

  .nav__link--active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .nav__dropdown-arrow {
    transition: transform var(--transition-fast);
  }

  .nav__dropdown:hover .nav__dropdown-arrow {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .nav__dropdown {
    position: relative;
  }

  .nav__dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--color-surface-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all var(--transition-base);
    z-index: var(--z-dropdown);
  }

  .nav__dropdown:hover .nav__dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__dropdown-item {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .nav__dropdown-item:hover {
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
  }

  .nav__dropdown-item--all {
    font-weight: var(--fw-semibold);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-1);
    padding-bottom: var(--space-3);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__cta {
    font-size: var(--fs-xs);
  }

  /* Mobile Toggle */
  .nav__toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    gap: 6px;
    z-index: calc(var(--z-sticky) + 1);
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }

  .nav__toggle:hover {
    background: rgba(255,255,255,0.04);
  }

  .nav__toggle span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-text-primary);
    border-radius: 2px;
    transition: all var(--transition-base);
    transform-origin: center;
  }

  .nav__toggle.open span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav__toggle.open span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* Mobile Menu */
  .nav__mobile {
    position: fixed;
    inset: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-slow);
    z-index: var(--z-sticky);
    overflow-y: auto;
  }

  .nav__mobile.open {
    opacity: 1;
    pointer-events: auto;
  }

  .nav__mobile-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-8);
    width: 100%;
    max-width: 320px;
    padding: var(--space-20) var(--space-6) var(--space-6);
  }

  .nav__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .nav__mobile-link {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    transition: color var(--transition-fast);
  }

  .nav__mobile-link:hover {
    color: var(--color-accent-text);
  }

  .nav__mobile-link:last-child {
    border-bottom: none;
  }

  .nav__mobile-link--sub {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    padding-left: var(--space-4);
  }

  .nav__mobile-section {
    display: flex;
    flex-direction: column;
  }

  .nav__mobile-section-title {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--ls-wider);
    color: var(--color-accent-text);
    padding: var(--space-4) 0 var(--space-1);
  }

  /* Dark Hero Variant — white text before scroll */
  .nav--hero-dark:not(.scrolled) .nav__link {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__link:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .nav--hero-dark:not(.scrolled) .nav__link--active {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__link--active::after {
    background: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__logo-text {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__dropdown-arrow {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__toggle span {
    background: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__cta.btn--secondary {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
  }

  .nav--hero-dark:not(.scrolled) .nav__cta.btn--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .nav__links,
    .nav__actions {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  function initNav() {
    const header = document.getElementById('nav-header');
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');

    // Dark hero detection — check if page has a dark image hero
    const hasDarkHero = !!document.querySelector('.hero, .sport-hero, .historia-hero, .socios-hero, .contacto-hero');
    if (hasDarkHero) {
      header?.classList.add('nav--hero-dark');
    } else {
      header?.classList.remove('nav--hero-dark');
    }

    // Scroll effect
    const onScroll = () => {
      if (window.scrollY > 20) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Mobile toggle
    toggle?.addEventListener('click', () => {
      const isOpen = menu?.classList.contains('open');
      toggle.classList.toggle('open');
      menu?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu?.setAttribute('aria-hidden', String(!!isOpen));
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    // Close on link click
    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle?.classList.remove('open');
        menu?.classList.remove('open');
        document.body.style.overflow = '';
      });
    });

    // Auth Check
    const role = localStorage.getItem('userRole');
    const navLoginBtn = document.getElementById('nav-login-btn') as HTMLAnchorElement;
    const navSignupBtn = document.getElementById('nav-signup-btn') as HTMLAnchorElement;
    const mobLoginBtn = document.getElementById('mobile-login-btn') as HTMLAnchorElement;
    const mobSignupBtn = document.getElementById('mobile-signup-btn') as HTMLAnchorElement;

    const doLogout = (e: Event) => {
      e.preventDefault();
      localStorage.removeItem('userRole');
      localStorage.removeItem('userEmail');
      window.location.href = '/login';
    };

    if (role) {
      if (navLoginBtn) {
        navLoginBtn.textContent = 'Logout';
        navLoginBtn.href = '#';
        navLoginBtn.addEventListener('click', doLogout);
      }
      if (mobLoginBtn) {
        mobLoginBtn.textContent = 'Logout';
        mobLoginBtn.href = '#';
        mobLoginBtn.addEventListener('click', doLogout);
      }
      if (navSignupBtn) {
        navSignupBtn.textContent = 'Painel';
        navSignupBtn.href = role === 'admin' ? '/admin' : '/perfil';
      }
      if (mobSignupBtn) {
        mobSignupBtn.textContent = 'Painel';
        mobSignupBtn.href = role === 'admin' ? '/admin' : '/perfil';
      }
    }
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
