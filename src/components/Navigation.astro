---
const clubeLinks = [
  { label: 'História', href: '/clube/historia' },
  { label: 'Conquistas', href: '/clube/conquistas' },
  { label: 'Órgãos Sociais', href: '/clube/orgaos-sociais' },
  { label: 'Regulamentos', href: '/clube/regulamentos' },
];

const modalidadesLinks = [
  { label: 'Futebol', href: '/modalidades/futebol' },
  { label: 'Ginástica', href: '/modalidades/ginastica' },
  { label: 'Karaté', href: '/modalidades/karate' },
  { label: 'Boxe Olímpico', href: '/modalidades/boxe' },
  { label: 'Halterofilismo', href: '/modalidades/halterofilismo' },
];

const navLinks = [
  { label: 'Notícias', href: '/noticias' },
  { label: 'Eventos', href: '/eventos' },
  { label: 'Contactos', href: '/contactos' },
];

const currentPath = Astro.url.pathname;
---

<!-- Mobile backdrop overlay -->
<div class="nav__mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

<header class="nav" id="nav-header">
  <div class="nav__inner container">
    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="Grupo Sportivo de Carcavelos — Página Inicial">
      <svg class="nav__logo-mark" width="28" height="28" viewBox="0 0 28 28" fill="none">
        <rect width="28" height="28" rx="7" fill="url(#gsc-logo-gradient)"/>
        <text x="14" y="19" text-anchor="middle" font-size="13" font-weight="800" fill="#ffffff" font-family="system-ui">G</text>
        <defs>
          <linearGradient id="gsc-logo-gradient" x1="0" y1="0" x2="28" y2="28">
            <stop stop-color="#16A34A"/>
            <stop offset="1" stop-color="#15803D"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="nav__logo-text">GS</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav__links" aria-label="Navegação principal">
      <!-- Clube Dropdown -->
      <div class="nav__dropdown">
        <a href="/clube/historia" class:list={['nav__link', { 'nav__link--active': currentPath.startsWith('/clube') }]}>
          Clube
          <svg class="nav__dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="nav__dropdown-menu">
          {clubeLinks.map((link) => (
            <a href={link.href} class="nav__dropdown-item">{link.label}</a>
          ))}
        </div>
      </div>

      <!-- Modalidades Dropdown -->
      <div class="nav__dropdown">
        <a href="/modalidades" class:list={['nav__link', { 'nav__link--active': currentPath.startsWith('/modalidades') }]}>
          Modalidades
          <svg class="nav__dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="nav__dropdown-menu">
          <a href="/modalidades" class="nav__dropdown-item nav__dropdown-item--all">Todas as Modalidades</a>
          {modalidadesLinks.map((link) => (
            <a href={link.href} class="nav__dropdown-item">{link.label}</a>
          ))}
        </div>
      </div>

      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': currentPath === link.href }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="nav__actions">
      <a href="/login" class="btn btn--secondary btn--sm btn--pill nav__cta" id="nav-login-btn" style="margin-right: var(--space-2);">
        Login
      </a>
      <a href="/socios" class="btn btn--primary btn--sm btn--pill nav__cta" id="nav-signup-btn">
        Torna-te Sócio
      </a>
    </div>

    <!-- Mobile Toggle -->
    <button class="nav__toggle" id="mobile-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="nav__mobile" id="mobile-menu" aria-hidden="true">
    <!-- Drawer header -->
    <div class="nav__mobile-header">
      <a href="/" class="nav__mobile-logo">
        <svg width="24" height="24" viewBox="0 0 28 28" fill="none">
          <rect width="28" height="28" rx="7" fill="url(#mobile-logo-gradient)"/>
          <text x="14" y="19" text-anchor="middle" font-size="13" font-weight="800" fill="#ffffff" font-family="system-ui">G</text>
          <defs>
            <linearGradient id="mobile-logo-gradient" x1="0" y1="0" x2="28" y2="28">
              <stop stop-color="#16A34A"/>
              <stop offset="1" stop-color="#15803D"/>
            </linearGradient>
          </defs>
        </svg>
        <span>GS Carcavelos</span>
      </a>
      <button class="nav__mobile-close" id="mobile-close" aria-label="Fechar menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <nav class="nav__mobile-inner">
      <div class="nav__mobile-links">
        <a href="/" class:list={['nav__mobile-link', { 'nav__mobile-link--active': currentPath === '/' }]}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Início
        </a>

        <!-- Collapsible Clube section -->
        <div class="nav__mobile-section" id="mobile-section-clube">
          <button class:list={['nav__mobile-section-toggle', { 'nav__mobile-section-toggle--active': currentPath.startsWith('/clube') }]} aria-expanded="false" aria-controls="mobile-clube-links">
            <span class="nav__mobile-section-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Clube
            </span>
            <svg class="nav__mobile-section-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="nav__mobile-section-links" id="mobile-clube-links" hidden>
            {clubeLinks.map((link) => (
              <a href={link.href} class:list={['nav__mobile-link', 'nav__mobile-link--sub', { 'nav__mobile-link--active': currentPath === link.href }]}>{link.label}</a>
            ))}
          </div>
        </div>

        <!-- Collapsible Modalidades section -->
        <div class="nav__mobile-section" id="mobile-section-modalidades">
          <button class:list={['nav__mobile-section-toggle', { 'nav__mobile-section-toggle--active': currentPath.startsWith('/modalidades') }]} aria-expanded="false" aria-controls="mobile-modalidades-links">
            <span class="nav__mobile-section-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93l14.14 14.14M12 2a10 10 0 000 20"/></svg>
              Modalidades
            </span>
            <svg class="nav__mobile-section-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="nav__mobile-section-links" id="mobile-modalidades-links" hidden>
            <a href="/modalidades" class="nav__mobile-link nav__mobile-link--sub nav__mobile-link--all">Ver Todas</a>
            {modalidadesLinks.map((link) => (
              <a href={link.href} class:list={['nav__mobile-link', 'nav__mobile-link--sub', { 'nav__mobile-link--active': currentPath === link.href }]}>{link.label}</a>
            ))}
          </div>
        </div>

        <a href="/noticias" class:list={['nav__mobile-link', { 'nav__mobile-link--active': currentPath === '/noticias' }]}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H8a2 2 0 00-2 2v16a2 2 0 01-2 2zm0 0a2 2 0 01-2-2V9"/><path d="M18 14H10M15 18H10M10 6h8"/></svg>
          Notícias
        </a>
        <a href="/eventos" class:list={['nav__mobile-link', { 'nav__mobile-link--active': currentPath === '/eventos' }]}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Eventos
        </a>
        <a href="/contactos" class:list={['nav__mobile-link', { 'nav__mobile-link--active': currentPath === '/contactos' }]}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012 .84h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          Contactos
        </a>
      </div>

      <div class="nav__mobile-actions">
        <a href="/login" class="btn btn--secondary btn--lg nav__mobile-cta" id="mobile-login-btn">
          Login
        </a>
        <a href="/socios" class="btn btn--primary btn--lg nav__mobile-cta" id="mobile-signup-btn">
          Torna-te Sócio
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-sticky);
    transition: all var(--transition-base);
  }

  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    border-bottom: 1px solid transparent;
    transition: all var(--transition-slow);
  }

  .nav.scrolled::before {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px) saturate(1.8);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    border-bottom-color: var(--color-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  /* Logo */
  .nav__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    z-index: calc(var(--z-sticky) + 1);
  }

  .nav__logo-text {
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  /* Desktop Links */
  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link {
    position: relative;
    padding: 0.4rem 0.75rem;
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    color: #000000;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav__link:hover {
    color: var(--color-accent);
  }

  .nav__link--active {
    color: var(--color-accent);
  }

  .nav__link--active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .nav__dropdown-arrow {
    transition: transform var(--transition-fast);
  }

  .nav__dropdown:hover .nav__dropdown-arrow {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .nav__dropdown {
    position: relative;
  }

  .nav__dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--color-surface-glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all var(--transition-base);
    z-index: var(--z-dropdown);
  }

  .nav__dropdown:hover .nav__dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__dropdown-item {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .nav__dropdown-item:hover {
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
  }

  .nav__dropdown-item--all {
    font-weight: var(--fw-semibold);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-1);
    padding-bottom: var(--space-3);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__cta {
    font-size: var(--fs-xs);
  }

  /* Mobile Toggle */
  .nav__toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    gap: 5px;
    z-index: calc(var(--z-sticky) + 1);
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
    touch-action: manipulation;
  }

  .nav__toggle:hover {
    background: rgba(0,0,0,0.06);
  }

  .nav__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 2px;
    transition: all var(--transition-base);
    transform-origin: center;
  }

  .nav__toggle.open span:first-child {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__toggle.open span:last-child {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Menu — slide in from right */
  .nav__mobile {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100vw, 380px);
    background: var(--color-bg-primary);
    border-left: 1px solid var(--color-border);
    box-shadow: var(--shadow-xl);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateX(100%);
    pointer-events: none;
    transition: opacity var(--transition-slow), transform var(--transition-slow);
    z-index: var(--z-sticky);
    overscroll-behavior: contain;
  }

  .nav__mobile.open {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* Backdrop overlay behind the slide-in menu */
  .nav__mobile-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: calc(var(--z-sticky) - 1);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-slow);
  }

  .nav__mobile-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Drawer header */
  .nav__mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .nav__mobile-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: 1rem;
    color: var(--color-text-primary);
  }

  .nav__mobile-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
  }

  .nav__mobile-close:hover {
    background: var(--color-border);
    color: var(--color-text-primary);
  }

  .nav__mobile-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-4) var(--space-5) var(--space-6);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .nav__mobile-links {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0;
    overflow-y: auto;
  }

  .nav__mobile-link {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-text-primary);
    text-decoration: none;
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: color var(--transition-fast), background var(--transition-fast);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    border-radius: var(--radius-md);
    touch-action: manipulation;
  }

  .nav__mobile-link:hover,
  .nav__mobile-link:active {
    color: var(--color-accent-text);
    background: var(--color-accent-muted);
  }

  .nav__mobile-link--sub {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    padding-left: var(--space-5);
    min-height: 44px;
  }

  .nav__mobile-link--all {
    font-weight: var(--fw-semibold);
    color: var(--color-accent-text);
  }

  .nav__mobile-link--active {
    color: var(--color-accent-text);
    background: var(--color-accent-muted);
  }

  .nav__mobile-section-toggle--active .nav__mobile-section-title {
    color: var(--color-accent-text);
  }

  /* Collapsible section */
  .nav__mobile-section {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .nav__mobile-section-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-4) var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-weight: var(--fw-semibold);
    color: var(--color-text-primary);
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    min-height: 52px;
    transition: background var(--transition-fast), color var(--transition-fast);
    touch-action: manipulation;
  }

  .nav__mobile-section-toggle:hover,
  .nav__mobile-section-toggle:active {
    background: var(--color-bg-secondary);
  }

  .nav__mobile-section-toggle[aria-expanded="true"] {
    color: var(--color-accent-text);
  }

  .nav__mobile-section-arrow {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
    color: var(--color-text-tertiary);
  }

  .nav__mobile-section-toggle[aria-expanded="true"] .nav__mobile-section-arrow {
    transform: rotate(180deg);
    color: var(--color-accent-text);
  }

  .nav__mobile-section-title {
    font-family: var(--font-display);
    font-size: var(--fs-body-lg);
    font-weight: var(--fw-semibold);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav__mobile-section-links {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-2);
    animation: slideDown 0.2s var(--ease-out);
  }

  .nav__mobile-section-links[hidden] {
    display: none;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .nav__mobile-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-6);
    margin-top: auto;
    border-top: 1px solid var(--color-border);
  }

  .nav__mobile-cta {
    width: 100%;
    text-align: center;
  }

  /* Dark Hero Variant — white text before scroll */
  .nav--hero-dark:not(.scrolled) .nav__link {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__link:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .nav--hero-dark:not(.scrolled) .nav__link--active {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__link--active::after {
    background: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__logo-text {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__dropdown-arrow {
    color: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__toggle span {
    background: #ffffff;
  }

  .nav--hero-dark:not(.scrolled) .nav__cta.btn--secondary {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
  }

  .nav--hero-dark:not(.scrolled) .nav__cta.btn--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .nav__links,
    .nav__actions {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  function initNav() {
    const header = document.getElementById('nav-header');
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');

    // Dark hero detection
    const hasDarkHero = !!document.querySelector('.hero, .sport-hero, .historia-hero, .socios-hero, .contacto-hero');
    if (hasDarkHero) {
      header?.classList.add('nav--hero-dark');
    } else {
      header?.classList.remove('nav--hero-dark');
    }

    // Scroll effect
    const onScroll = () => {
      if (window.scrollY > 20) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Open / close mobile menu
    const openMenu = () => {
      toggle?.classList.add('open');
      menu?.classList.add('open');
      backdrop?.classList.add('open');
      toggle?.setAttribute('aria-expanded', 'true');
      menu?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeMenu = () => {
      toggle?.classList.remove('open');
      menu?.classList.remove('open');
      backdrop?.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    toggle?.addEventListener('click', () => {
      const isOpen = menu?.classList.contains('open');
      isOpen ? closeMenu() : openMenu();
    });

    // Close button inside drawer
    document.getElementById('mobile-close')?.addEventListener('click', closeMenu);

    // Close on backdrop click
    backdrop?.addEventListener('click', closeMenu);

    // Close on link click
    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu?.classList.contains('open')) {
        closeMenu();
        toggle?.focus();
      }
    });

    // Collapsible sections
    menu?.querySelectorAll('.nav__mobile-section-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const targetId = btn.getAttribute('aria-controls');
        const target = targetId ? document.getElementById(targetId) : null;

        btn.setAttribute('aria-expanded', String(!expanded));
        if (target) {
          if (expanded) {
            target.hidden = true;
          } else {
            target.hidden = false;
          }
        }
      });
    });

    // Auth Check
    const role = localStorage.getItem('userRole');
    const navLoginBtn = document.getElementById('nav-login-btn') as HTMLAnchorElement;
    const navSignupBtn = document.getElementById('nav-signup-btn') as HTMLAnchorElement;
    const mobLoginBtn = document.getElementById('mobile-login-btn') as HTMLAnchorElement;
    const mobSignupBtn = document.getElementById('mobile-signup-btn') as HTMLAnchorElement;

    const doLogout = (e: Event) => {
      e.preventDefault();
      localStorage.removeItem('userRole');
      localStorage.removeItem('userEmail');
      window.location.href = '/login';
    };

    if (role) {
      if (navLoginBtn) {
        navLoginBtn.textContent = 'Logout';
        navLoginBtn.href = '#';
        navLoginBtn.addEventListener('click', doLogout);
      }
      if (mobLoginBtn) {
        mobLoginBtn.textContent = 'Logout';
        mobLoginBtn.href = '#';
        mobLoginBtn.addEventListener('click', doLogout);
      }
      if (navSignupBtn) {
        navSignupBtn.textContent = 'Painel';
        navSignupBtn.href = role === 'admin' ? '/admin' : '/perfil';
      }
      if (mobSignupBtn) {
        mobSignupBtn.textContent = 'Painel';
        mobSignupBtn.href = role === 'admin' ? '/admin' : '/perfil';
      }
    }
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
