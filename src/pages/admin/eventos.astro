---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AdminNav from '../../components/AdminNav.astro';
---

<Layout title="Administracao - Eventos" description="Gestao de Eventos.">
  <PageHeader
    badge="Eventos"
    title="Gestao de"
    highlight="Eventos"
    description="Interface para gerir os eventos do site."
  />

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <AdminNav />

      <div class="card reveal" style="padding: var(--space-6); margin-top: var(--space-4);">
        <div class="admin-header">
           <h2 class="text-h3" style="margin: 0;">Lista de Eventos</h2>
           <button class="btn btn--primary btn--sm" onclick="openEventModal()">+ Novo Evento</button>
        </div>

        <div class="table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Titulo</th>
                <th>Data</th>
                <th>Tag & Cor</th>
                <th style="text-align: right;">Acoes</th>
              </tr>
            </thead>
            <tbody id="events-list">
              <tr><td colspan="4" style="text-align:center; padding: 4rem;">A carregar eventos...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Event Modal -->
  <div id="event-modal" class="modal">
    <div class="modal__overlay" onclick="closeEventModal()"></div>
    <div class="modal__content card">
       <div class="modal__header-banner">
        <button class="modal__close-btn" onclick="closeEventModal()">
           <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal__scroll-area">
         <h3 id="event-modal-title" style="margin-bottom: var(--space-4);">Adicionar Evento</h3>
         <form id="event-form" onsubmit="saveEvent(event)">
            <input type="hidden" id="event-id" />

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Titulo do Evento</label>
                <input type="text" id="event-title" class="form-input" required placeholder="Ex: Torneio de Verao 2025" />
            </div>

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Data Visivel</label>
                <input type="text" id="event-date" class="form-input" required placeholder="Ex: 21 Jun 2025" />
            </div>

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Descricao</label>
                <input type="text" id="event-desc" class="form-input" placeholder="Breve descricao do evento..." />
            </div>

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Tag (Apresentacao)</label>
                <input type="text" id="event-tag" class="form-input" placeholder="Ex: Competicao" />
            </div>

            <div style="margin-bottom: var(--space-6);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Cor do Badge</label>
                <select id="event-color" class="form-input">
                   <option value="green">Verde</option>
                   <option value="violet">Violeta</option>
                   <option value="amber">Ambar</option>
                </select>
            </div>

            <button type="submit" class="btn btn--primary" style="width: 100%;">Guardar Evento</button>
         </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  let ALL_EVENTS = [] as any[];

  async function loadEvents() {
    const role = localStorage.getItem('userRole');
    if (role !== 'admin') {
      window.location.href = '/login';
      return;
    }

    try {
      const res = await fetch('/api/admin/events');
      const data = await res.json();
      if (data.success) {
        ALL_EVENTS = data.events;
        renderEvents(ALL_EVENTS);
      }
    } catch {
       const tbody = document.getElementById('events-list');
       if (tbody) tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:red;">Erro ao carregar eventos.</td></tr>';
    }
  }

  function renderEvents(eventsList: any[]) {
    const tbody = document.getElementById('events-list');
    if (!tbody) return;

    if (eventsList.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 4rem;">Nenhum evento registado.</td></tr>';
      return;
    }

    tbody.innerHTML = eventsList.map(e => `
        <tr>
            <td style="font-weight: 600;">${e.title}</td>
            <td>${e.date}</td>
            <td><span class="status-badge" style="background: var(--color-bg-tertiary); color: var(--color-text-primary); border-left: 3px solid var(--color-accent);">${e.tag || 'Sem Tag'} (${e.color})</span></td>
            <td style="text-align: right;">
               <button class="action-btn action-btn--icon-only" onclick="editEvent(${e.id})" title="Editar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
               </button>
               <button class="action-btn action-btn--icon-only" onclick="deleteEvent(${e.id})" title="Apagar" style="color: red;">
                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
               </button>
            </td>
        </tr>
    `).join('');
  }

  (window as any).openEventModal = () => {
      document.getElementById('event-id')!.value = '';
      (document.getElementById('event-form') as HTMLFormElement).reset();
      document.getElementById('event-modal-title')!.textContent = 'Adicionar Evento';
      document.getElementById('event-modal')?.classList.add('active');
  };

  (window as any).closeEventModal = () => {
      document.getElementById('event-modal')?.classList.remove('active');
  };

  (window as any).editEvent = (id: number) => {
      const eventInfo = ALL_EVENTS.find(e => e.id === id);
      if (!eventInfo) return;

      document.getElementById('event-id')!.value = eventInfo.id.toString();
      document.getElementById('event-title')!.value = eventInfo.title;
      document.getElementById('event-date')!.value = eventInfo.date;
      document.getElementById('event-desc')!.value = eventInfo.desc || '';
      document.getElementById('event-tag')!.value = eventInfo.tag || '';
      document.getElementById('event-color')!.value = eventInfo.color || 'green';

      document.getElementById('event-modal-title')!.textContent = 'Editar Evento';
      document.getElementById('event-modal')?.classList.add('active');
  };

  (window as any).saveEvent = async (e: Event) => {
      e.preventDefault();

      const payload = {
          id: document.getElementById('event-id')?.value || null,
          title: (document.getElementById('event-title') as HTMLInputElement).value,
          date: (document.getElementById('event-date') as HTMLInputElement).value,
          desc: (document.getElementById('event-desc') as HTMLInputElement).value,
          tag: (document.getElementById('event-tag') as HTMLInputElement).value,
          color: (document.getElementById('event-color') as HTMLSelectElement).value
      };

      try {
          const res = await fetch('/api/admin/events', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
              (window as any).closeEventModal();
              loadEvents();
          } else {
              alert('Erro: ' + data.message);
          }
      } catch {
          alert('Erro na comunicacao do servidor.');
      }
  };

  (window as any).deleteEvent = async (id: number) => {
      if (!confirm('Eliminar este evento?')) return;
      try {
          const res = await fetch('/api/admin/event', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id })
          });
          const data = await res.json();
          if (data.success) loadEvents();
          else alert('Erro: ' + data.message);
      } catch {
          alert('Erro do servidor ao eliminar.');
      }
  };

  loadEvents();
  document.addEventListener('astro:after-swap', loadEvents);
</script>

<style is:global>
  /* Reuse admin and modal styles here */
  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
  }
  .table-wrapper { overflow-x: auto; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .admin-table th, .admin-table td { padding: var(--space-4); border-bottom: 1px solid var(--color-border); }
  .admin-table th { text-align: left; font-size: var(--fs-xxs); text-transform: uppercase; color: var(--color-text-muted); }
  .admin-table tr { transition: all var(--transition-fast); }
  .admin-table tr:hover { background: var(--color-bg-secondary); }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
  }
  .action-btn:hover { background: var(--color-bg-tertiary); }
  .status-badge { display: inline-flex; padding: 4px 10px; border-radius: 99px; font-size: 10px; font-weight: bold; }
  .status--paid { background: #dcfce7; color: #166534; }
  .modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 1rem; opacity: 0; visibility: hidden; }
  .modal.active { opacity: 1; visibility: visible; }
  .modal__overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); }
  .modal__content { position: relative; width: 100%; max-width: 600px; max-height: 90vh; background: var(--color-bg-primary); padding: 2rem; border-radius: var(--radius-xl); z-index: 1001; overflow-y: auto; }
  .modal__close-btn { position: absolute; top: 1rem; right: 1rem; cursor: pointer; background: transparent; border: none; }
  .form-input { width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-secondary); color: var(--color-text-primary); }
</style>
