---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AdminNav from '../../components/AdminNav.astro';
---

<Layout title="Administracao - Noticias" description="Gestao de Noticias do GS Carcavelos.">
  <PageHeader
    badge="Noticias"
    title="Gestao de"
    highlight="Noticias"
    description="Interface para gerir artigos e noticias publicados no site."
  />

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <AdminNav />

      <div class="card reveal" style="padding: var(--space-6); margin-top: var(--space-4);">
        <div class="admin-header">
           <h2 class="text-h3" style="margin: 0;">Lista de Noticias</h2>
           <button class="btn btn--primary btn--sm" onclick="openNewsModal()">+ Nova Noticia</button>
        </div>

        <div class="table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Titulo</th>
                <th>Slug</th>
                <th>Tag</th>
                <th>Data</th>
                <th style="text-align: right;">Acoes</th>
              </tr>
            </thead>
            <tbody id="news-list">
              <tr><td colspan="5" style="text-align:center; padding: 4rem;">A carregar noticias...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- News Modal -->
  <div id="news-modal" class="modal">
    <div class="modal__overlay" onclick="closeNewsModal()"></div>
    <div class="modal__content card" style="max-width: 700px;">
       <div class="modal__header-banner">
        <button class="modal__close-btn" onclick="closeNewsModal()">
           <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal__scroll-area">
         <h3 id="news-modal-title" style="margin-bottom: var(--space-4);">Adicionar Noticia</h3>
         <form id="news-form" onsubmit="saveNews(event)">
            <input type="hidden" id="news-id" />

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Titulo *</label>
                <input type="text" id="news-title" class="form-input" required placeholder="Titulo da noticia" oninput="generateSlug()" />
            </div>

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Slug (URL)</label>
                <input type="text" id="news-slug" class="form-input" required placeholder="titulo-da-noticia" />
            </div>

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Resumo</label>
                <input type="text" id="news-excerpt" class="form-input" placeholder="Breve resumo da noticia..." />
            </div>

            <div style="margin-bottom: var(--space-4);">
                <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Conteudo *</label>
                <textarea id="news-content" class="form-input" style="height: 160px;" required placeholder="Corpo da noticia (suporta HTML)..."></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4);">
                <div>
                    <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">Tag</label>
                    <input type="text" id="news-tag" class="form-input" placeholder="Ex: Competicao" />
                </div>
                <div>
                    <label style="display: block; font-size: var(--fs-small); margin-bottom: var(--space-2);">URL da Imagem</label>
                    <input type="url" id="news-image" class="form-input" placeholder="https://..." />
                </div>
            </div>

            <button type="submit" class="btn btn--primary" style="width: 100%;">Guardar Noticia</button>
         </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  let ALL_NEWS = [] as any[];

  async function loadNews() {
    const role = localStorage.getItem('userRole');
    if (role !== 'admin') {
      window.location.href = '/login';
      return;
    }

    try {
      const res = await fetch('/api/admin/news');
      const data = await res.json();
      if (data.success) {
        ALL_NEWS = data.news;
        renderNews(ALL_NEWS);
      }
    } catch {
       const tbody = document.getElementById('news-list');
       if (tbody) tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:red;">Erro ao carregar noticias.</td></tr>';
    }
  }

  function renderNews(newsList: any[]) {
    const tbody = document.getElementById('news-list');
    if (!tbody) return;

    if (newsList.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding: 4rem;">Nenhuma noticia registada.</td></tr>';
      return;
    }

    tbody.innerHTML = newsList.map(n => {
      const date = n.created_at ? new Date(n.created_at).toLocaleDateString('pt-PT') : '\u2014';
      return `
        <tr>
            <td style="font-weight: 600;">${n.title}</td>
            <td><code style="font-size: 11px; background: var(--color-bg-tertiary); padding: 2px 6px; border-radius: 4px;">${n.slug}</code></td>
            <td>${n.tag ? `<span class="status-badge status--paid">${n.tag}</span>` : '\u2014'}</td>
            <td>${date}</td>
            <td style="text-align: right;">
               <button class="action-btn action-btn--icon-only" onclick="editNews(${n.id})" title="Editar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
               </button>
               <button class="action-btn action-btn--icon-only" onclick="deleteNews(${n.id})" title="Apagar" style="color: red;">
                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
               </button>
            </td>
        </tr>
      `;
    }).join('');
  }

  (window as any).generateSlug = () => {
    const title = (document.getElementById('news-title') as HTMLInputElement).value;
    const slug = title
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    (document.getElementById('news-slug') as HTMLInputElement).value = slug;
  };

  (window as any).openNewsModal = () => {
      document.getElementById('news-id')!.value = '';
      (document.getElementById('news-form') as HTMLFormElement).reset();
      document.getElementById('news-modal-title')!.textContent = 'Adicionar Noticia';
      document.getElementById('news-modal')?.classList.add('active');
  };

  (window as any).closeNewsModal = () => {
      document.getElementById('news-modal')?.classList.remove('active');
  };

  (window as any).editNews = (id: number) => {
      const article = ALL_NEWS.find(n => n.id === id);
      if (!article) return;

      document.getElementById('news-id')!.value = article.id.toString();
      (document.getElementById('news-title') as HTMLInputElement).value = article.title;
      (document.getElementById('news-slug') as HTMLInputElement).value = article.slug;
      (document.getElementById('news-excerpt') as HTMLInputElement).value = article.excerpt || '';
      (document.getElementById('news-content') as HTMLTextAreaElement).value = article.content || '';
      (document.getElementById('news-tag') as HTMLInputElement).value = article.tag || '';
      (document.getElementById('news-image') as HTMLInputElement).value = article.image_url || '';

      document.getElementById('news-modal-title')!.textContent = 'Editar Noticia';
      document.getElementById('news-modal')?.classList.add('active');
  };

  (window as any).saveNews = async (e: Event) => {
      e.preventDefault();

      const payload = {
          id: document.getElementById('news-id')?.value || null,
          title: (document.getElementById('news-title') as HTMLInputElement).value,
          slug: (document.getElementById('news-slug') as HTMLInputElement).value,
          excerpt: (document.getElementById('news-excerpt') as HTMLInputElement).value,
          content: (document.getElementById('news-content') as HTMLTextAreaElement).value,
          tag: (document.getElementById('news-tag') as HTMLInputElement).value,
          image_url: (document.getElementById('news-image') as HTMLInputElement).value
      };

      try {
          const res = await fetch('/api/admin/news', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
              (window as any).closeNewsModal();
              loadNews();
          } else {
              alert('Erro: ' + data.message);
          }
      } catch {
          alert('Erro na comunicacao do servidor.');
      }
  };

  (window as any).deleteNews = async (id: number) => {
      if (!confirm('Eliminar esta noticia?')) return;
      try {
          const res = await fetch('/api/admin/news', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id })
          });
          const data = await res.json();
          if (data.success) loadNews();
          else alert('Erro: ' + data.message);
      } catch {
          alert('Erro do servidor ao eliminar.');
      }
  };

  loadNews();
  document.addEventListener('astro:after-swap', loadNews);
</script>

<style is:global>
  /* Reuse admin and modal styles here */
  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-8);
  }
  .table-wrapper { overflow-x: auto; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .admin-table th, .admin-table td { padding: var(--space-4); border-bottom: 1px solid var(--color-border); }
  .admin-table th { text-align: left; font-size: var(--fs-xxs); text-transform: uppercase; color: var(--color-text-muted); }
  .admin-table tr { transition: all var(--transition-fast); }
  .admin-table tr:hover { background: var(--color-bg-secondary); }
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
  }
  .action-btn:hover { background: var(--color-bg-tertiary); }
  .status-badge { display: inline-flex; padding: 4px 10px; border-radius: 99px; font-size: 10px; font-weight: bold; }
  .status--paid { background: #dcfce7; color: #166534; }
  .modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 1rem; opacity: 0; visibility: hidden; }
  .modal.active { opacity: 1; visibility: visible; }
  .modal__overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); }
  .modal__content { position: relative; width: 100%; max-width: 700px; max-height: 90vh; background: var(--color-bg-primary); padding: 2rem; border-radius: var(--radius-xl); z-index: 1001; overflow-y: auto; }
  .modal__close-btn { position: absolute; top: 1rem; right: 1rem; cursor: pointer; background: transparent; border: none; }
  .form-input { width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-secondary); color: var(--color-text-primary); }
</style>
