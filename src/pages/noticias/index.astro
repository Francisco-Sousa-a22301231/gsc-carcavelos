---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Notícias" description="Últimas notícias e atualizações do Grupo Sportivo de Carcavelos.">
  <PageHeader
    badge="Notícias"
    title="Últimas"
    highlight="Notícias"
    description="Acompanha as novidades e atualizações do GSC."
  />

  <section class="section">
    <div class="container">
      <div class="empty-state reveal">
        <div class="empty-state__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M18 18h-8M18 10h-8"/></svg>
        </div>
        <h2 class="text-h3">Em breve novas notícias</h2>
        <p class="text-secondary">As notícias do GSC serão publicadas aqui em breve. As novidades serão geridas através do painel de administração.</p>
        <a href="/" class="btn btn--secondary btn--pill">
          Voltar ao Início
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .empty-state {
    text-align: center;
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    max-width: 480px;
    margin: 0 auto;
  }

  .empty-state__icon {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-2xl);
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .empty-state p {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-relaxed);
  }
</style>
