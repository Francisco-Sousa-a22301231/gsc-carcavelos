---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { siteConfig } from '../data/site-content';
---

<Layout title="Contactos" description="Entre em contacto com o Grupo Sportivo de Carcavelos. Morada, telefone, email e formulário de contacto.">
  <PageHeader
    badge="Contacto"
    title="Fale"
    highlight="Connosco"
    description="Tem alguma questão ou sugestão? Entre em contacto connosco."
  />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="contact-form-wrapper reveal">
          <h2 class="text-h3">Envie-nos uma mensagem</h2>
          <form id="contact-form" class="contact-form">
            <div class="form-group">
              <label for="nome" class="form-label">Nome</label>
              <input type="text" id="nome" name="nome" class="form-input" placeholder="O seu nome" required />
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Email</label>
              <input type="email" id="email" name="email" class="form-input" placeholder="o.seu@email.com" required />
            </div>
            <div class="form-group">
              <label for="assunto" class="form-label">Assunto</label>
              <input type="text" id="assunto" name="assunto" class="form-input" placeholder="Assunto da mensagem" required />
            </div>
            <div class="form-group">
              <label for="mensagem" class="form-label">Mensagem</label>
              <textarea id="mensagem" name="mensagem" class="form-input" rows="5" placeholder="A sua mensagem..." required></textarea>
            </div>
            <div id="contact-status" class="contact-status" style="display:none;"></div>
            <button type="submit" class="btn btn--primary btn--lg" style="width:100%;">
              Enviar Mensagem
              <span class="btn-arrow">&rarr;</span>
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="contact-info reveal reveal-delay-1">
          <div class="info-card card">
            <div class="info-card__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <h3 class="text-h4">Morada</h3>
            <p class="text-secondary">{siteConfig.address}</p>
          </div>

          <div class="info-card card">
            <div class="info-card__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <h3 class="text-h4">Telefone</h3>
            <p class="text-secondary">{siteConfig.phone}</p>
          </div>

          <div class="info-card card">
            <div class="info-card__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <h3 class="text-h4">Email</h3>
            <p class="text-secondary">{siteConfig.contactEmail}</p>
          </div>

          <div class="info-card card">
            <div class="info-card__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            </div>
            <h3 class="text-h4">Campo de Treinos</h3>
            <p class="text-secondary">{siteConfig.trainingGround}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const statusEl = document.getElementById('contact-status') as HTMLElement;
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/contactos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        statusEl.style.display = 'block';
        if (result.success) {
          statusEl.className = 'contact-status contact-status--success';
          statusEl.textContent = 'Mensagem enviada com sucesso! Entraremos em contacto brevemente.';
          form.reset();
        } else {
          statusEl.className = 'contact-status contact-status--error';
          statusEl.textContent = result.message || 'Erro ao enviar mensagem. Tente novamente.';
        }
      } catch (err) {
        statusEl.style.display = 'block';
        statusEl.className = 'contact-status contact-status--error';
        statusEl.textContent = 'Erro de ligação. Tente novamente.';
      }
    });
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-10);
    align-items: start;
  }

  .contact-form-wrapper h2 {
    margin-bottom: var(--space-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact-form textarea.form-input {
    resize: vertical;
    min-height: 120px;
  }

  .contact-status {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--fs-small);
    text-align: center;
  }

  .contact-status--success {
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.3);
    color: #059669;
  }

  .contact-status--error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: var(--color-danger);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .info-card__icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-lg);
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .info-card p {
    font-size: var(--fs-small);
    line-height: var(--lh-relaxed);
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
