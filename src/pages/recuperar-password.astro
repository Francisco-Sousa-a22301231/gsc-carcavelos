---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Recuperar Password" description="Recupera a tua password de acesso ao Grupo Sportivo de Carcavelos.">
  <section class="recover-page">
    <div class="container">
      <div class="recover-card reveal">
        <div class="recover-header">
          <h1 class="text-h2">Recuperar Password</h1>
          <p class="text-secondary">Introduz o teu email para recuperar o acesso à tua conta.</p>
        </div>

        <form id="recover-form" class="recover-form">
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="o.teu@email.com" required />
          </div>

          <button type="submit" class="btn btn--primary btn--lg" style="width:100%;">
            Enviar Pedido
          </button>
        </form>

        <div class="recover-info">
          <div class="recover-info__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </div>
          <p>Contacte o clube para recuperar a sua password: <a href="mailto:gscarcavelos@gmail.com">gscarcavelos@gmail.com</a></p>
        </div>

        <div class="recover-footer">
          <a href="/login" class="recover-link">Voltar ao login</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .recover-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-height) + var(--space-16)) 0 var(--space-24);
  }

  .recover-card {
    max-width: 400px;
    width: 100%;
    margin: 0 auto;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-10);
    box-shadow: var(--shadow-lg);
  }

  .recover-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .recover-header h1 {
    margin-bottom: var(--space-2);
  }

  .recover-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .recover-info {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: var(--color-accent-muted);
    border-radius: var(--radius-md);
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .recover-info__icon {
    color: var(--color-accent-text);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .recover-info p {
    font-size: var(--fs-small);
    color: var(--color-text-secondary);
    line-height: var(--lh-relaxed);
  }

  .recover-info a {
    color: var(--color-accent-text);
    font-weight: var(--fw-semibold);
  }

  .recover-info a:hover {
    text-decoration: underline;
  }

  .recover-footer {
    margin-top: var(--space-6);
    text-align: center;
  }

  .recover-link {
    font-size: var(--fs-small);
    color: var(--color-text-tertiary);
  }

  .recover-link:hover {
    color: var(--color-text-primary);
  }
</style>
