---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="Parceiros" description="Os parceiros do Grupo Sportivo de Carcavelos.">
  <PageHeader
    badge="Parceiros"
    title="Os Nossos"
    highlight="Parceiros"
    description="As empresas e instituições que apoiam o GSC."
  />

  <section class="section">
    <div class="container">
      <div class="empty-state reveal">
        <div class="empty-state__icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h2 class="text-h3">Em breve</h2>
        <p class="text-secondary">Os parceiros do GSC serão apresentados aqui em breve. A gestão de parceiros é feita através do painel de administração.</p>
        <a href="/" class="btn btn--secondary btn--pill">
          Voltar ao Início
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .empty-state {
    text-align: center;
    padding: var(--space-16) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    max-width: 480px;
    margin: 0 auto;
  }

  .empty-state__icon {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-2xl);
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .empty-state p {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-relaxed);
  }
</style>
