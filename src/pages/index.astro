---
import Layout from '../layouts/Layout.astro';
import { heroContent, stats, sports, values, socioBenefits, events, siteConfig } from '../data/site-content';
---

<Layout title="Início" description="Grupo Sportivo de Carcavelos — Clube desportivo fundado em 1922. Futebol, ginástica, karaté, boxe olímpico e halterofilismo.">
  <!-- JSON-LD Structured Data -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsOrganization",
      "name": "Grupo Sportivo de Carcavelos",
      "alternateName": "GS",
      "foundingDate": "1922",
      "url": "https://gscarcavelos.org",
      "logo": "https://gscarcavelos.org/images/logo/gsc-logo.svg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Plácido Abreu, 70",
        "addressLocality": "Carcavelos",
        "postalCode": "2775-617",
        "addressCountry": "PT"
      },
      "telephone": "+351214570894",
      "email": "gscarcavelos@gmail.com",
      "sport": ["Football", "Gymnastics", "Karate", "Boxing", "Weightlifting"],
      "sameAs": [
        siteConfig.social.facebook,
        siteConfig.social.instagram,
        siteConfig.social.youtube,
      ]
    })} />
  </Fragment>

  <!-- ═══════════════════════════════════════
       HERO — Full-screen with dual image fade
  ═══════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__bg">
      <img src="/images/hero/football-aerial.jpg" alt="Campo de futebol" class="hero__bg-image hero__bg-image--1" loading="eager" />
      <img src="/images/hero/football-field.jpg" alt="Campo da Quinta Nova" class="hero__bg-image hero__bg-image--2" loading="eager" />
      <div class="hero__overlay"></div>
      <div class="hero__overlay-gradient"></div>
    </div>
    <div class="container hero__content">
      <span class="badge badge--hero reveal">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Fundado em 1922
      </span>
      <h1 class="text-display reveal reveal-delay-1">
        {heroContent.title}
        <span class="hero__highlight">{heroContent.highlight}</span>
      </h1>
      <p class="hero__desc text-body-lg reveal reveal-delay-2">
        {heroContent.description}
      </p>
      <div class="hero__actions reveal reveal-delay-3">
        <a href="/socios" class="btn btn--hero-primary btn--lg btn--pill">
          Torna-te Sócio
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/modalidades" class="btn btn--hero-secondary btn--lg btn--pill">
          Ver Modalidades
        </a>
      </div>
      <!-- Social proof strip -->
      <div class="hero__social-proof reveal reveal-delay-3">
        <div class="hero__avatars">
          <img src="/images/sports/futebol.png" alt="" class="hero__avatar" />
          <img src="/images/sports/ginastica.png" alt="" class="hero__avatar" />
          <img src="/images/sports/karate.png" alt="" class="hero__avatar" />
        </div>
        <span class="hero__social-text">+300 atletas em 5 modalidades</span>
      </div>
    </div>
    <div class="hero__scroll-indicator reveal reveal-delay-3">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       STATS — Animated counters
  ═══════════════════════════════════════════ -->
  <section class="section--sm">
    <div class="container">
      <div class="stats-grid reveal">
        {stats.map((stat, i) => (
          <div class="stat-item">
            <span class="stat-value" data-count={stat.value.replace('+', '')} data-suffix={stat.value.includes('+') ? '+' : ''}>{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       ABOUT — Split layout with image
  ═══════════════════════════════════════════ -->
  <section class="section about-section">
    <div class="container">
      <div class="about-split">
        <div class="about-split__visual reveal">
          <div class="about-split__img-wrapper">
            <img src="/images/hero/football-field.jpg" alt="Campo da Quinta Nova — GS Carcavelos" loading="lazy" class="about-split__img" />
            <div class="about-split__badge">
              <span class="about-split__badge-year">1922</span>
              <span class="about-split__badge-label">Fundação</span>
            </div>
          </div>
          <!-- Floating image 2 -->
          <div class="about-split__float">
            <img src="/images/gallery/campo-1.jpg" alt="Jogo do GSC" loading="lazy" class="about-split__float-img" />
          </div>
        </div>
        <div class="about-split__text reveal reveal-delay-2">
          <span class="badge">O Nosso Clube</span>
          <h2 class="text-h2">Mais de <span class="text-gradient">100 Anos</span><br/>de Desporto</h2>
          <p class="about-split__desc">
            O Grupo Sportivo de Carcavelos nasceu em 1922 como símbolo de desporto e comunidade. Ao longo de um século, forjámos campeões, formámos pessoas e unimos gerações em torno do desporto.
          </p>
          <p class="about-split__desc">
            Hoje, com 5 modalidades ativas e um renovado Campo da Quinta Nova (inaugurado em 2023 com investimento de 300 000€), o GS olha para o futuro mantendo viva a sua alma centenária.
          </p>
          <div class="about-split__actions">
            <a href="/clube/historia" class="btn btn--primary btn--pill">
              Conhece a Nossa História
              <span class="btn-arrow">&rarr;</span>
            </a>
            <a href="/clube/conquistas" class="btn btn--secondary btn--pill">
              Conquistas
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       IMAGE STRIP — Horizontal scroll
  ═══════════════════════════════════════════ -->
  <div class="image-strip" aria-hidden="true">
    <div class="image-strip__track">
      <img src="/images/gallery/campo-1.jpg" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/sports/futebol.png" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/gallery/campo-2.jpg" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/sports/ginastica.png" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/gallery/campo-3.jpg" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/sports/karate.png" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/hero/football-field.jpg" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/hero/football-aerial.jpg" alt="" class="image-strip__img" loading="lazy" />
      <!-- Duplicate for seamless loop -->
      <img src="/images/gallery/campo-1.jpg" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/sports/futebol.png" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/gallery/campo-2.jpg" alt="" class="image-strip__img" loading="lazy" />
      <img src="/images/sports/ginastica.png" alt="" class="image-strip__img" loading="lazy" />
    </div>
  </div>

  <!-- ═══════════════════════════════════════
       GALLERY — Expanded 9-image grid
  ═══════════════════════════════════════════ -->
  <section class="section bg-dots">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge">Galeria</span>
        <h2 class="text-h2">Campo da <span class="text-gradient">Quinta Nova</span></h2>
        <p>Recinto desportivo renovado com investimento de 300 000€, inaugurado em janeiro de 2023.</p>
      </div>
      <div class="gallery-grid reveal">
        <!-- Feature (top-left, spans 2 cols x 2 rows) -->
        <div class="gallery-item gallery-item--featured">
          <img src="/images/sports/futebol.png" alt="Futebol no GSC — Campo da Quinta Nova" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay">
            <span class="gallery-item__label">Futebol</span>
          </div>
        </div>
        <!-- Top right col 3 -->
        <div class="gallery-item">
          <img src="/images/gallery/campo-1.jpg" alt="Jogo do GS Carcavelos" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay">
            <span class="gallery-item__label">Jogo</span>
          </div>
        </div>
        <!-- Row 2 col 3 -->
        <div class="gallery-item">
          <img src="/images/gallery/campo-2.jpg" alt="GS Carcavelos em campo" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay">
            <span class="gallery-item__label">Treino</span>
          </div>
        </div>
        <!-- Row 3 col 1 -->
        <div class="gallery-item">
          <img src="/images/sports/ginastica.png" alt="Ginástica — GS Carcavelos" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay">
            <span class="gallery-item__label">Ginástica</span>
          </div>
        </div>
        <!-- Row 3 col 2 -->
        <div class="gallery-item">
          <img src="/images/gallery/campo-3.jpg" alt="GS Carcavelos — jogo" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay">
            <span class="gallery-item__label">Campo</span>
          </div>
        </div>
        <!-- Row 3 col 3 -->
        <div class="gallery-item">
          <img src="/images/sports/karate.png" alt="Karaté — GS Carcavelos" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay">
            <span class="gallery-item__label">Karaté</span>
          </div>
        </div>
        <!-- Row 4 — wide banner -->
        <div class="gallery-item gallery-item--wide">
          <img src="/images/hero/football-aerial.jpg" alt="Vista aérea do Campo da Quinta Nova" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay gallery-item__overlay--wide">
            <span class="gallery-item__label">Vista Aérea — Quinta Nova</span>
          </div>
        </div>
        <!-- Row 4 col 3 -->
        <div class="gallery-item">
          <img src="/images/hero/football-field.jpg" alt="Campo da Quinta Nova" loading="lazy" class="gallery-img" />
          <div class="gallery-item__overlay">
            <span class="gallery-item__label">Quinta Nova</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       MODALIDADES — Sport Cards with images
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge">Modalidades</span>
        <h2 class="text-h2">5 Desportos, Uma <span class="text-gradient">Família</span></h2>
        <p>Descobre a modalidade ideal para ti. Do futebol à ginástica, do karaté ao halterofilismo.</p>
      </div>
      <div class="sports-grid reveal">
        {sports.map((sport, i) => (
          <a href={`/modalidades/${sport.slug}`} class={`sport-card sport-color--${sport.color} reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="sport-card__media">
              <img
                src={sport.image || '/images/hero/football-aerial.jpg'}
                alt={sport.name}
                loading="lazy"
                class="sport-card__img"
                onerror="this.src='/images/hero/football-aerial.jpg'"
              />
              <div class="sport-card__media-overlay" style={`background: color-mix(in srgb, var(--sport-accent) 60%, transparent);`}></div>
              <span class="sport-card__sport-label">{sport.name}</span>
            </div>
            <div class="sport-card__body">
              <div class="sport-card__icon" style={`background: var(--sport-accent-muted); color: var(--sport-accent);`}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/></svg>
              </div>
              <p class="sport-card__desc">{sport.description}</p>
              <span class="sport-card__link" style={`color: var(--sport-accent);`}>
                Saber mais &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       FULL-WIDTH CTA BANNER — Dark overlay
  ═══════════════════════════════════════════ -->
  <section class="cta-banner">
    <div class="cta-banner__bg">
      <img src="/images/hero/football-aerial.jpg" alt="" class="cta-banner__img" loading="lazy" aria-hidden="true" />
      <div class="cta-banner__overlay"></div>
    </div>
    <div class="container cta-banner__content reveal">
      <span class="badge badge--hero">Campo da Quinta Nova</span>
      <h2 class="cta-banner__title">Faz Parte do<br/><span class="cta-banner__highlight">GS Carcavelos</span></h2>
      <p class="cta-banner__desc">Mais de 100 anos de tradição. Torna-te sócio e junta-te à nossa família desportiva.</p>
      <div class="cta-banner__actions">
        <a href="/socios" class="btn btn--hero-primary btn--lg btn--pill">
          Inscreve-te Agora
          <span class="btn-arrow">&rarr;</span>
        </a>
        <a href="/contactos" class="btn btn--hero-secondary btn--lg btn--pill">
          Fala Connosco
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       VALUES — 3 cards
  ═══════════════════════════════════════════ -->
  <section class="section bg-grid">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge">Os Nossos Valores</span>
        <h2 class="text-h2">Mais de 100 Anos de <span class="text-gradient">Tradição</span></h2>
        <p>Desde 1922, o GSC tem sido um pilar do desporto e da comunidade em Carcavelos.</p>
      </div>
      <div class="grid grid--3">
        {values.map((val, i) => (
          <div class={`card step-card reveal reveal-delay-${i + 1}`}>
            <div class="step-card__header">
              <div class={`step-card__icon step-card__icon--${val.color}`}>
                <Fragment set:html={val.icon} />
              </div>
            </div>
            <h3 class="text-h4">{val.title}</h3>
            <p class="text-secondary">{val.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       BENEFITS — Member perks
  ═══════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge">Sócios</span>
        <h2 class="text-h2">Faz Parte do <span class="text-gradient">GSC</span></h2>
        <p>Torna-te sócio e desfruta de todas as vantagens de pertencer ao nosso clube.</p>
      </div>
      <div class="grid grid--3">
        {socioBenefits.map((benefit, i) => (
          <div class={`card step-card reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="step-card__header">
              <div class={`step-card__icon step-card__icon--${benefit.color}`}>
                <Fragment set:html={benefit.icon} />
              </div>
            </div>
            <h3 class="text-h4">{benefit.title}</h3>
            <p class="text-secondary">{benefit.desc}</p>
          </div>
        ))}
      </div>
      <div class="cta-center reveal">
        <a href="/socios" class="btn btn--primary btn--lg btn--pill">
          Inscreve-te Agora
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       EVENTS PREVIEW — upcoming
  ═══════════════════════════════════════════ -->
  <section class="section bg-dots">
    <div class="container">
      <div class="section-header reveal">
        <span class="badge">Eventos</span>
        <h2 class="text-h2">Próximos <span class="text-gradient">Eventos</span></h2>
        <p>Acompanha o calendário de atividades e eventos do GSC.</p>
      </div>
      <div class="steps-grid">
        {events.map((event, i) => (
          <div class={`card step-card reveal reveal-delay-${(i % 2) + 1}`}>
            <div class="step-card__header">
              <div class={`step-card__icon step-card__icon--${event.color}`}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              </div>
              <span class="step-card__date">{event.date}</span>
            </div>
            <h3 class="text-h4">{event.title}</h3>
            <p class="text-secondary">{event.desc}</p>
            <span class="badge--subtle badge" style="align-self: flex-start;">{event.tag}</span>
          </div>
        ))}
      </div>
      <div class="cta-center reveal">
        <a href="/eventos" class="btn btn--secondary btn--lg btn--pill">
          Ver Todos os Eventos
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Hero ─────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__bg-image--1 {
    animation: hero-crossfade 12s infinite alternate ease-in-out;
    z-index: 1;
  }

  .hero__bg-image--2 {
    z-index: 0;
    opacity: 1;
  }

  @keyframes hero-crossfade {
    0%, 40% { opacity: 1; }
    60%, 100% { opacity: 0; }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.3) 40%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }

  .hero__overlay-gradient {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(22, 163, 74, 0.15) 0%, transparent 70%);
  }

  .hero__content {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-24) 0;
  }

  .hero__content .text-display {
    color: #ffffff;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .hero__highlight {
    display: block;
    background: linear-gradient(135deg, #4ade80 0%, #facc15 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__desc {
    max-width: 600px;
    color: rgba(255, 255, 255, 0.88);
    padding-inline: var(--space-6);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  .badge--hero {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10px);
  }

  .btn--hero-primary {
    background: var(--color-accent);
    color: #ffffff;
    font-weight: var(--fw-semibold);
    box-shadow: 0 4px 20px rgba(22, 163, 74, 0.45);
  }

  .btn--hero-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(22, 163, 74, 0.55);
  }

  .btn--hero-secondary {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
  }

  .btn--hero-secondary:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  /* Social proof */
  .hero__social-proof {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    backdrop-filter: blur(10px);
  }

  .hero__avatars {
    display: flex;
  }

  .hero__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.4);
    object-fit: cover;
    margin-left: -8px;
    background: var(--color-accent-muted);
  }

  .hero__avatar:first-child { margin-left: 0; }

  .hero__social-text {
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.9);
    font-weight: var(--fw-medium);
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.5);
    animation: bounce-down 2s infinite;
    z-index: 4;
  }

  @keyframes bounce-down {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ─── Stats ─────────────────────────────── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    padding: var(--space-10) var(--space-8);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: var(--fw-extrabold);
    color: var(--color-accent-text);
    letter-spacing: var(--ls-tight);
  }

  .stat-label {
    font-size: var(--fs-small);
    color: var(--color-text-tertiary);
    font-weight: var(--fw-medium);
  }

  /* ─── About Split ─────────────────────── */
  .about-section {
    overflow: hidden;
  }

  .about-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .about-split__visual {
    position: relative;
  }

  .about-split__img-wrapper {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-xl);
  }

  .about-split__img {
    width: 100%;
