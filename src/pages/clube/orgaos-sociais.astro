---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Órgãos Sociais" description="Órgãos sociais e direção do Grupo Sportivo de Carcavelos para o mandato 2024–2027.">
  <PageHeader
    badge="Órgãos Sociais"
    title="Direção"
    highlight="2024–2027"
    description="Os órgãos sociais eleitos para o mandato 2024–2027."
  />

  <!-- Direção -->
  <section class="section">
    <div class="container container--md">
      <div class="section-header reveal">
        <span class="badge">Direção</span>
        <h2 class="text-h2">Mesa da <span class="text-gradient">Direção</span></h2>
      </div>

      <div class="grid grid--3">
        <div class="card member-card reveal">
          <div class="member-card__avatar">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">Miguel João Esteves Domingues</h3>
          <span class="member-role">Presidente</span>
        </div>
        <div class="card member-card reveal reveal-delay-1">
          <div class="member-card__avatar">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Vice-Presidente</span>
        </div>
        <div class="card member-card reveal reveal-delay-2">
          <div class="member-card__avatar">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Tesoureiro</span>
        </div>
        <div class="card member-card reveal reveal-delay-1">
          <div class="member-card__avatar">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Secretário</span>
        </div>
        <div class="card member-card reveal reveal-delay-2">
          <div class="member-card__avatar">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Vogal</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Assembleia Geral -->
  <section class="section bg-grid">
    <div class="container container--md">
      <div class="section-header reveal">
        <span class="badge">Assembleia</span>
        <h2 class="text-h2">Assembleia <span class="text-gradient">Geral</span></h2>
      </div>

      <div class="grid grid--3">
        <div class="card member-card reveal">
          <div class="member-card__avatar member-card__avatar--amber">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Presidente da Mesa</span>
        </div>
        <div class="card member-card reveal reveal-delay-1">
          <div class="member-card__avatar member-card__avatar--amber">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">1.º Secretário</span>
        </div>
        <div class="card member-card reveal reveal-delay-2">
          <div class="member-card__avatar member-card__avatar--amber">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">2.º Secretário</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Conselho Fiscal -->
  <section class="section">
    <div class="container container--md">
      <div class="section-header reveal">
        <span class="badge">Fiscalização</span>
        <h2 class="text-h2">Conselho <span class="text-gradient">Fiscal</span></h2>
      </div>

      <div class="grid grid--3">
        <div class="card member-card reveal">
          <div class="member-card__avatar member-card__avatar--blue">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Presidente</span>
        </div>
        <div class="card member-card reveal reveal-delay-1">
          <div class="member-card__avatar member-card__avatar--blue">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Relator</span>
        </div>
        <div class="card member-card reveal reveal-delay-2">
          <div class="member-card__avatar member-card__avatar--blue">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <h3 class="text-h4">A confirmar</h3>
          <span class="member-role">Secretário</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .member-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }

  .member-card__avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-accent-muted);
    color: var(--color-accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .member-card__avatar--amber {
    background: var(--color-accent-2-muted);
    color: var(--color-accent-2);
  }

  .member-card__avatar--blue {
    background: var(--color-accent-3-muted);
    color: var(--color-accent-3);
  }

  .member-role {
    font-size: var(--fs-small);
    color: var(--color-text-tertiary);
    font-weight: var(--fw-medium);
  }
</style>
