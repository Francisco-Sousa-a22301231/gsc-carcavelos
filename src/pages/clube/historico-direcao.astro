---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="Histórico de Presidentes" description="Presidentes do Grupo Sportivo de Carcavelos desde 1922.">
  <PageHeader
    badge="Histórico"
    title="Presidentes do"
    highlight="GSC"
    description="Os presidentes que lideraram o Grupo Sportivo de Carcavelos desde a sua fundação."
  />

  <section class="section">
    <div class="container container--md">
      <div class="timeline reveal">
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1922</div>
          <div class="timeline__content">Edgar Muller Elias — Presidente fundador do Grupo Sportivo de Carcavelos.</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1925</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1930</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1940</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1950</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1960</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1970</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1980</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">1990</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">2000</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">2010</div>
          <div class="timeline__content">A confirmar</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__dot"></div>
          <div class="timeline__year">2024</div>
          <div class="timeline__content">Miguel João Esteves Domingues — Presidente eleito para o mandato 2024–2027.</div>
        </div>
      </div>
    </div>
  </section>
</Layout>
